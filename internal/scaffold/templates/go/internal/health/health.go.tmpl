// Package health serves the liveness (/ping) and readiness (/health) probes.
package health

import (
	"context"
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
)

// Checker is implemented once per external dependency (database, cache, broker).
type Checker interface {
	Name() string
	Check(ctx context.Context) error
}

// Handler serves the health endpoints.
type Handler struct {
	build    string
	started  time.Time
	checkers []Checker
}

// New includes every checker in the readiness report.
func New(build string, checkers ...Checker) *Handler {
	return &Handler{build: build, started: time.Now(), checkers: checkers}
}

// Liveness never touches dependencies.
func (h *Handler) Liveness(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{
		"status": "ok",
		"build":  h.build,
		"uptime": time.Since(h.started).String(),
	})
}

// Readiness returns 503 when any checker fails.
func (h *Handler) Readiness(c *gin.Context) {
	ctx, cancel := context.WithTimeout(c.Request.Context(), 2*time.Second)
	defer cancel()

	deps := make(map[string]string, len(h.checkers))
	ready := true
	for _, ck := range h.checkers {
		if err := ck.Check(ctx); err != nil {
			deps[ck.Name()] = err.Error()
			ready = false
			continue
		}
		deps[ck.Name()] = "ok"
	}

	status, verdict := http.StatusOK, "ready"
	if !ready {
		status, verdict = http.StatusServiceUnavailable, "not ready"
	}
	c.JSON(status, gin.H{"status": verdict, "dependencies": deps})
}
