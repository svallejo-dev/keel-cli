# Todas las variables que consume configs/config.yaml. Local: cópialo a .env (o usa keel).
# En QA/prod no se usa: inyecta la plataforma. Nunca pongas secretos reales aquí.

# --- servidor (todas opcionales: el contrato trae defaults) ---
{{.EnvPrefix}}_HOST=0.0.0.0
{{.EnvPrefix}}_PORT=8080
{{.EnvPrefix}}_READ_TIMEOUT=5s
{{.EnvPrefix}}_WRITE_TIMEOUT=10s
{{.EnvPrefix}}_IDLE_TIMEOUT=120s
{{.EnvPrefix}}_SHUTDOWN_TIMEOUT=20s

# Apunta a otro archivo de contrato (p. ej. un mapeo por ambiente):
# {{.EnvPrefix}}_CONFIG=configs/config.yaml

{{if ne .ConfigStore "none" -}}
# --- config store (valores de la app: flags, límites, terceros) ---
# Local los emite `keel sync`. Sin CONFIG_STORE el servicio usa solo el entorno.
# CONFIG_STORE=vault
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=hvs.xxxxx                      # en K8s: secret / Vault Agent
# CONFIG_VAULT_MOUNT=secret
# CONFIG_VAULT_PATH={{.Name}}
{{- if eq .ConfigStore "aws"}}
#
# Alternativa AWS Secrets Manager (un secreto JSON {"KEY":"valor",...}):
# CONFIG_STORE=aws-secretsmanager
# CONFIG_SECRET_ID={{.Name}}-config
{{- end}}

{{end -}}
# --- dependencias (descomenta según lo que declares en configs/config.yaml) ---
# AWS_ENDPOINT_URL=http://127.0.0.1:4566     # en AWS real: NO definirla
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test                     # en AWS real: usar IAM role, no claves
# AWS_SECRET_ACCESS_KEY=test
# ADMIN_EVENTS_TABLE=admin-events
# ADMIN_ASSETS_BUCKET=admin-assets
