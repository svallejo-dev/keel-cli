# syntax=docker/dockerfile:1

# --- build stage ------------------------------------------------------------
FROM golang:{{.GoVersion}}-alpine AS build
WORKDIR /src

# Cache module downloads first.
COPY go.mod go.sum ./
RUN go mod download

# Build a static binary; stamp the build id via ldflags.
COPY . .
ARG BUILD=develop
RUN CGO_ENABLED=0 go build \
	-ldflags "-s -w -X main.build=${BUILD}" \
	-o /bin/{{.Name}} ./cmd/{{.Name}}

# --- run stage --------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /bin/{{.Name}} /bin/{{.Name}}
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/bin/{{.Name}}"]
