# keel platform configuration (environment variables).
# These configure the PLATFORM itself, not the instances it creates.
# Copy/export as needed; all are optional (sensible defaults apply).

# Provider engine: auto (default) | real | mock
#   auto -> real when Docker is available, otherwise mock (simulated)
KEEL_ENGINE=auto

# State + audit-log directory (default: ~/.keel)
# KEEL_HOME=/path/to/state

# AWS region reported to floci
KEEL_REGION=us-east-1

# floci AWS-API endpoint
KEEL_FLOCI_ENDPOINT=http://localhost:4566

# Shared docker network for backing containers + floci
KEEL_DOCKER_NETWORK=keel-net

# Default project id for GCP emulators (Identity Platform). demo-* ids make the
# emulators refuse to touch real Google resources.
KEEL_GCP_PROJECT=demo-keel
